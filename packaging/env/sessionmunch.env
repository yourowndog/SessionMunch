# Environment file read by the system sessionmunch.service.
#
# Keep one KEY=value assignment per line. Do not quote values unless the value
# itself contains quotes; systemd EnvironmentFile is not a shell script.
#
# Common choices:
# SESSIONMUNCH_AUTH_TOKEN=<generated with: sessionmunch generate-auth-token>
# SESSIONMUNCH_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# SESSIONMUNCH_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# SESSIONMUNCH_LLM_REASONING_EFFORT=low
# SESSIONMUNCH_LLM_HEADERS=x-opencode-session=host-01,x-opencode-client=sessionmunch
# SESSIONMUNCH_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
